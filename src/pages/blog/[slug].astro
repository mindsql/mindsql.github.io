---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} · mindsql`} description={post.data.description}>
  <article class="container">
    <header>
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h1>{post.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a href="/blog">返回全部文章</a></p>
  </article>
</Base>

<style>
  article {
    max-width: var(--measure);
    padding-block: 3rem 1rem;
  }
  header time {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  header h1 {
    font-family: var(--serif);
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    font-weight: 700;
    line-height: 1.35;
    margin-top: 0.4rem;
    overflow-wrap: break-word;
    text-wrap: balance;
  }
  .prose {
    margin-top: 2rem;
  }
  .prose :global(h2) {
    font-size: 1.3rem;
    margin: 2.2rem 0 0.8rem;
  }
  .prose :global(h3) {
    font-size: 1.1rem;
    margin: 1.8rem 0 0.6rem;
  }
  .prose :global(p) {
    margin-block: 0.9rem;
    color: var(--ink);
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0.9rem 0 0.9rem 1.4rem;
  }
  .prose :global(li) {
    margin-block: 0.3rem;
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--accent-wash);
    padding: 0.12em 0.4em;
    border-radius: 4px;
  }
  .prose :global(pre) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem 1.2rem;
    overflow-x: auto;
    margin-block: 1.2rem;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.86rem;
  }
  .prose :global(blockquote) {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.7rem 1.2rem;
    color: var(--ink-2);
    margin-block: 1.2rem;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .back {
    margin-top: 3rem;
    font-size: 0.92rem;
  }
</style>
