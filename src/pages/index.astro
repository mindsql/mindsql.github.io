---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recent = posts.slice(0, 2);

const phrases = [
  '读书，思考，写作。',
  '把想法慢慢写成文章。',
  '在字里行间认真生活。',
];

const journey = [
  { date: '2026-10-27', text: '立了个念头：要有一个自己的主页，于是有了这个账号。' },
  { date: '2026-10-28', text: '主页第一版上线。' },
  { date: '2026-10-28', text: '主页改版：从工具风换成如今的书卷样子。' },
];
---

<Base title="mindsql">
  <section class="bento container" aria-label="主页">
    <article class="card intro tilt">
      <div class="intro-head">
        <div>
          <h1>mindsql</h1>
          <p class="typing-line">
            <span class="typing" data-phrases={JSON.stringify(phrases)}>{phrases[0]}</span><span
              class="caret"
              aria-hidden="true"></span>
          </p>
        </div>
        <img
          class="avatar"
          src="/avatar.svg"
          alt="mindsql 的头像"
          width="84"
          height="84" />
      </div>
      <p class="bio">
        数字人文方向的研究者，关注知识组织、文本挖掘与阅读史。
        相信写清楚是想清楚的一部分。
      </p>
      <a class="btn-primary" href="/blog">读我的文章</a>
    </article>

    <article class="card recent tilt" aria-label="最近文章">
      <h2>最近文章</h2>
      {recent.length > 0 ? (
        <ul class="recent-list">
          {recent.map((post) => (
            <li>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
              </time>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="card-note">还没有文章，第一篇随笔在路上。</p>
      )}
    </article>

    <article class="card now tilt" aria-label="近况">
      <h2>近况</h2>
      <p>主页刚刚安顿好，下一篇随笔在酝酿中。</p>
    </article>

    <article class="card research tilt" aria-label="研究方向">
      <h2>研究方向</h2>
      <ul class="pill-list">
        <li>数字人文</li>
        <li>知识组织</li>
        <li>文本挖掘</li>
        <li>阅读史</li>
      </ul>
      <p class="card-note">具体课题整理中，会陆续写进文章里。</p>
    </article>

    <article class="card motto" aria-label="座右铭">
      <p class="motto-text">慢慢想，认真写。</p>
    </article>
  </section>

  <section id="about" class="container block">
    <h2>关于</h2>
    <p class="body-text">
      mindsql，学习者与写作者。我相信写清楚是想清楚的一部分，
      所以把笔记和随笔都放在这里。文章在「写作」一栏；
      这个主页本身也是一件慢慢打磨的作品，它的历程记录在「历程」里。
    </p>
    <p class="body-text contact-line">
      来信请寄 <a href="mailto:mindsql@example.com">mindsql@example.com</a>。
    </p>
  </section>

  <section id="cv" class="container block">
    <h2>简历</h2>
    <div class="cv-grid">
      <div>
        <h3>教育</h3>
        <ol class="timeline">
          <li><time>2024 — 至今</time><p>临江大学 信息管理学院，硕士在读</p></li>
          <li><time>2020 — 2024</time><p>临江大学 人文学院，本科</p></li>
        </ol>
      </div>
      <div>
        <h3>经历</h3>
        <ol class="timeline">
          <li><time>2026</time><p>建立这个主页，开始公开写作</p></li>
          <li><time>2025</time><p>参与地方志文本数字化整理项目</p></li>
          <li><time>2024</time><p>本科论文：地方志目录的量化分析</p></li>
        </ol>
      </div>
    </div>
    <h3 class="papers-head">论文与长文</h3>
    <ul class="papers">
      <li><span>《目录学的计算方法：一个综述》</span><em>撰写中</em></li>
      <li><span>《卡片盒笔记法在文献综述里的应用》</span><em>撰写中</em></li>
    </ul>
  </section>

  <section class="container block">
    <h2>写作</h2>
    {posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </time>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="body-text">还没有文章。</p>
    )}
    <p class="body-text"><a href="/blog">全部文章</a></p>
  </section>

  <section id="log" class="container block">
    <h2>历程</h2>
    <ol class="timeline">
      {journey.map((item) => (
        <li>
          <time>{item.date}</time>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </section>
</Base>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 打字机：多短语循环（关闭动画时保持第一条静态文案）
  const typing = document.querySelector<HTMLSpanElement>('.typing');
  if (typing && !reduced) {
    const phrases = JSON.parse(typing.dataset.phrases ?? '[]') as string[];
    if (phrases.length > 1) {
      let pi = 0;
      let ci = phrases[0].length;
      let deleting = true;
      const step = () => {
        if (deleting) {
          ci -= 1;
          if (ci === 0) {
            deleting = false;
            pi = (pi + 1) % phrases.length;
          }
        } else {
          ci += 1;
          if (ci === phrases[pi].length) {
            deleting = true;
            window.setTimeout(step, 2400);
            return;
          }
        }
        typing.textContent = phrases[pi].slice(0, ci);
        window.setTimeout(step, deleting ? 38 : 120);
      };
      window.setTimeout(step, 2600);
    }
  }

  // 卡片倾斜：跟随鼠标的轻微 3D（只用 transform）
  if (!reduced) {
    document.querySelectorAll<HTMLElement>('.tilt').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.setProperty('--ry', `${(x * 3).toFixed(2)}deg`);
        card.style.setProperty('--rx', `${(-y * 3).toFixed(2)}deg`);
      });
      card.addEventListener('mouseleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      'intro intro recent'
      'intro intro now'
      'research research research'
      'motto motto motto';
    gap: 1rem;
    padding-block: 2.6rem 1rem;
  }
  .intro { grid-area: intro; }
  .recent { grid-area: recent; }
  .now { grid-area: now; }
  .research { grid-area: research; }
  .motto { grid-area: motto; }

  @media (max-width: 720px) {
    .bento {
      grid-template-areas: 'intro' 'recent' 'now' 'research' 'motto';
    }
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .tilt {
    transform: perspective(700px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.18s ease-out, box-shadow 0.18s ease-out;
  }
  .tilt:hover {
    box-shadow: var(--card-shadow);
  }

  .intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
  }
  .intro h1 {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .typing-line {
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--accent-ink);
    min-height: 1.9em;
  }
  .caret {
    display: inline-block;
    width: 0.5em;
    height: 1.05em;
    background: var(--accent);
    vertical-align: -0.15em;
    margin-left: 4px;
    animation: caret-blink 1.1s steps(1) infinite;
  }
  @keyframes caret-blink {
    50% { opacity: 0; }
  }
  .bio {
    color: var(--ink-2);
    max-width: 30em;
  }
  .intro .btn-primary {
    align-self: flex-start;
    margin-top: 0.4rem;
  }

  .card h2 {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: 0.8rem;
  }
  .card-note {
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  .recent-list {
    list-style: none;
  }
  .recent-list li {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    padding-block: 0.35rem;
  }
  .recent-list time {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .recent-list a {
    font-size: 0.95rem;
    text-decoration: none;
  }
  .recent-list a:hover {
    text-decoration: underline;
  }

  .now p {
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .motto {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.8rem;
  }
  .motto-text {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .intro-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.2rem;
  }
  .avatar {
    border-radius: 16px;
    flex-shrink: 0;
  }

  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }
  .pill-list li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.12rem 0.85rem;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .contact-line {
    margin-top: 0.7rem;
  }

  .cv-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.2rem;
    max-width: var(--measure);
  }
  @media (max-width: 720px) {
    .cv-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .cv-grid h3,
  .papers-head {
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.9rem;
  }
  .papers-head {
    margin-top: 1.8rem;
  }
  .papers {
    list-style: none;
    max-width: var(--measure);
  }
  .papers li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .papers em {
    font-style: normal;
    font-size: 0.78rem;
    color: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.05rem 0.7rem;
    white-space: nowrap;
  }

  .block {
    padding-block: 2.4rem;
    border-top: 1px solid var(--line);
  }
  .block h2 {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .body-text {
    max-width: var(--measure);
    color: var(--ink-2);
  }

  .timeline {
    list-style: none;
    max-width: var(--measure);
    border-left: 2px solid var(--line);
    margin-left: 0.3rem;
  }
  .timeline li {
    position: relative;
    padding: 0 0 1.3rem 1.4rem;
  }
  .timeline li:last-child {
    padding-bottom: 0.2rem;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.45em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-ink);
  }
  .timeline time {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--ink-2);
  }
  .timeline p {
    margin-top: 0.1rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .post-list {
    list-style: none;
    max-width: var(--measure);
  }
  .post-list li {
    display: flex;
    gap: 1.2rem;
    align-items: baseline;
    padding-block: 0.45rem;
  }
  .post-list time {
    font-family: var(--mono);
    font-size: 0.84rem;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .post-list a {
    text-decoration: none;
  }
  .post-list a:hover {
    text-decoration: underline;
  }
</style>
