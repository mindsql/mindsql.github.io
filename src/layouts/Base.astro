---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'mindsql 的个人主页与博客：写代码，做开源。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='18' fill='%23f6f5f1'/><rect x='22' y='22' width='13' height='56' fill='%2333586b'/><rect x='22' y='65' width='40' height='13' fill='%2333586b'/><rect x='47' y='42' width='13' height='36' fill='%237d97a5'/></svg>" />
  </head>
  <body>
    <header class="site-head">
      <div class="container head-row">
        <a class="wordmark" href="/">mindsql</a>
        <nav aria-label="主导航">
          <a href="/#cv">简历</a>
          <a href="/blog">写作</a>
          <a href="/#log">历程</a>
          <a href="/#about">关于</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="container foot-row">
        <span>© 2026 mindsql</span>
        <span><a href="https://github.com/mindsql/mindsql.github.io">网站源码</a></span>
        <span>由 GitHub Pages 部署</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-head {
    border-bottom: 1px solid var(--line);
  }
  .head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.1rem;
  }
  .wordmark {
    font-family: var(--mono);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
  }
  nav a {
    font-size: 0.92rem;
    color: var(--ink-2);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--accent-ink);
  }
  .site-foot {
    border-top: 1px solid var(--line);
    margin-top: 5rem;
  }
  .foot-row {
    display: flex;
    gap: 1.8rem;
    flex-wrap: wrap;
    padding-block: 1.6rem 2.2rem;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
</style>
